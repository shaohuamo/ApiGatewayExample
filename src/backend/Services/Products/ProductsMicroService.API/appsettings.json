{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceBus": {
    "ProductsUpdatesTopic": "products.updates",
    "ProductsUpdatesSubscription": "products.updates.test",
    "ProductsUpdatesReprocessTopic": "products.updates.Reprocess"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=$POSTGRES_HOST; Port=$POSTGRES_PORT; Database=$POSTGRES_DATABASE; Username=$POSTGRES_USER; Password=$POSTGRES_PASSWORD"
  }
}
