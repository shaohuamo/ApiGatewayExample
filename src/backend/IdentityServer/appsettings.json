{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "PostgresConnection": "Host=$POSTGRES_HOST; Port=$POSTGRES_PORT; Database=$POSTGRES_DATABASE; Username=$POSTGRES_USER; Password=$POSTGRES_PASSWORD"
  },
  "IdentityServer": {
    "IssuerUri": "http://localhost:8085",
    "TokenLifetimes": {
      "AccessTokenSeconds": 900,
      "AbsoluteRefreshTokenSeconds": 2592000
    }
  },
  "SeedUser": {
    "Enabled": true,
    "UserName": "test",
    "Email": "test@example.com",
    "Password": "P@ssw0rd123!"
  },
  "ResendEmail": {
    "ApiToken": "",
    "From": "MicroservicesDemo <verify@auth.250669.xyz>",
    "PublicBaseUrl": "https://localhost:8080",
    "ConfirmationSubject": "Confirm your MicroservicesDemo account"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "IdentityServer_",
    "ConnectRetry": 3,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "MaxReconnectDelay": 5000,
    "InitialReconnectDelay": 1000,
    "AbortOnConnectFail": false
  },
  "EmailVerificationRateLimit": {
    "Enabled": true,
    "FailOpenOnRedisError": true,
    "RegisterIpLimit": 5,
    "RegisterIpWindowMinutes": 10,
    "RegisterIpDailyLimit": 20,
    "RegisterIpDailyWindowHours": 24,
    "ResendIpLimit": 3,
    "ResendIpWindowMinutes": 10,
    "ResendEmailCooldownMinutes": 5,
    "ResendEmailDailyLimit": 5,
    "ResendEmailDailyWindowHours": 24
  },
  "Clients": {
    "Frontend": {
      "PublicUrl": "http://localhost:3000",
      "ClientId": "test_app",
      "ClientSecret": "frontend-secret"
    },
    "Postman": {
      "RedirectUri": "https://oauth.pstmn.io/v1/callback"
    }
  },
  "POSTGRES": {
    "Host": "localhost",
    "Port": "5432",
    "Database": "identitydatabase",
    "User": "postgres",
    "Password": "admin",
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  }
}
