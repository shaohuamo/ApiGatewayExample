{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "PostgresConnection": "Host=$POSTGRES_HOST; Port=$POSTGRES_PORT; Database=$POSTGRES_DATABASE; Username=$POSTGRES_USER; Password=$POSTGRES_PASSWORD"
  },
  "IdentityServer": {
    "IssuerUri": "http://localhost:8085",
    "TokenLifetimes": {
      "AccessTokenSeconds": 900,
      "AbsoluteRefreshTokenSeconds": 2592000
    }
  },
  "SeedUser": {
    "Enabled": true,
    "UserName": "test",
    "Email": "test@example.com",
    "Password": "123456"
  },
  "Clients": {
    "Frontend": {
      "PublicUrl": "http://localhost:3000",
      "ClientId": "test_app",
      "ClientSecret": "frontend-secret"
    },
    "Postman": {
      "RedirectUri": "https://oauth.pstmn.io/v1/callback"
    }
  },
  "POSTGRES": {
    "Host": "localhost",
    "Port": "5432",
    "Database": "identitydatabase",
    "User": "postgres",
    "Password": "admin",
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  }
}
