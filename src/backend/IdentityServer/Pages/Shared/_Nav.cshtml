@using Duende.IdentityServer.Extensions
@using IdentityServer.Localization
@using System.Globalization
@{
    #nullable enable
    string? name = null;
    if (!true.Equals(ViewData["signed-out"]))
    {
        name = Context.User?.GetDisplayName();
    }
    var currentCulture = CultureInfo.CurrentUICulture.Name.Equals("zh-CN", StringComparison.OrdinalIgnoreCase)
        ? "zh-CN"
        : "en";
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="nav-page">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <a href="~/" class="navbar-brand">
            <img src="~/duende-logo.svg" class="icon-banner">
            Duende IdentityServer
        </a>

        @if (!string.IsNullOrWhiteSpace(name))
        {
            <ul class="navbar-nav mr-auto">
                <li class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">@name <b class="caret"></b></a>
                    
                    <div class="dropdown-menu">
                        <a class="dropdown-item" asp-page="/Account/Logout/Index">@T["Logout"]</a>
                    </div>
              </li>
            </ul>
        }

        <form class="form-inline ml-auto" method="get" asp-page="/Culture/Set">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <label class="sr-only" for="culture-select">@T["Language"]</label>
            <select id="culture-select" name="culture" class="form-control form-control-sm">
                <option value="en" selected="@(currentCulture == "en")">@T["English"]</option>
                <option value="zh-CN" selected="@(currentCulture == "zh-CN")">@T["Chinese"]</option>
            </select>
        </form>
    
    </nav>
</div>
