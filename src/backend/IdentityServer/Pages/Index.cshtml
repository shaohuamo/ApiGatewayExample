@page
@model IdentityServer.Pages.Index

<div class="welcome-page">
    <h1>
        <img src="~/duende-logo.svg" class="logo">
        @T["Welcome to Duende IdentityServer"]
        <small class="text-muted">(@T["version"] @Model.Version)</small>
    </h1>

    <ul>
        <li>
            @T["IdentityServer publishes a"]
            <a href="~/.well-known/openid-configuration">@T["discovery document"]</a>
            @T["where you can find metadata and links to all the endpoints, key material, etc."]
        </li>
        <li>
            @T["Click"] <a href="~/diagnostics">@T["here"]</a> @T["to see the claims for your current session."]
        </li>
        <li>
            @T["Click"] <a href="~/grants">@T["here"]</a> @T["to manage your stored grants."]
        </li>
        <li>
            @T["Click"] <a href="~/serversidesessions">@T["here"]</a> @T["to view the server side sessions."]
        </li>
        <li>
            @T["Click"] <a href="~/ciba/all">@T["here"]</a> @T["to view your pending CIBA login requests."]
        </li>
        <li>
            @T["Here are links to the"]
            <a href="https://github.com/duendesoftware/IdentityServer">@T["source code repository"]</a>,
            @T["and"] <a href="https://github.com/duendesoftware/samples">@T["ready to use samples"]</a>.
        </li>
    </ul>

    @if(Model.License != null)
    {
        <h2>@T["License"]</h2>
        <dl>
            <dt>@T["Serial Number"]</dt>
            <dd>@Model.License.SerialNumber</dd>
            <dt>@T["Expiration"]</dt>
            <dd>@Model.License.Expiration!.Value.ToLongDateString()</dd>
        </dl>
    }
</div>
