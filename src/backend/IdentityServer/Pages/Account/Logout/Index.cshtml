@page
@model IdentityServer.Pages.Account.Logout.Index

<div class="logout-page">
    <div class="lead">
        <h1>@T["Logout"]</h1>
        <p>@T["Would you like to logout of IdentityServer?"]</p>
    </div>

    <form asp-page="/Account/Logout/Index">
        <input type="hidden" name="logoutId" value="@Model.LogoutId"  />
        
        <div class="form-group">
            <button class="btn btn-primary">@T["Yes"]</button>
        </div>
    </form>
</div>
