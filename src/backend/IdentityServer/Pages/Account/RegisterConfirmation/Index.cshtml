@page
@model IdentityServer.Pages.Account.RegisterConfirmation.Index

<div class="register-confirmation-page">
    <div class="lead">
        <h1>Check your email</h1>
        <p>Confirm your email address to finish creating your local account.</p>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="card">
                <div class="card-header">
                    <h2>Email confirmation required</h2>
                </div>
                <div class="card-body">
                    <p>
                        If an account was created for <strong>@Model.Email</strong>, a confirmation email has been sent.
                    </p>
                    <p>
                        Please open the link in that email before logging in.
                    </p>
                    <a class="btn btn-primary"
                       asp-page="/Account/Login/Index"
                       asp-route-returnUrl="@Model.ReturnUrl">Back to Login</a>
                    <a class="btn btn-link"
                       asp-page="/Account/ResendConfirmation/Index"
                       asp-route-email="@Model.Email"
                       asp-route-returnUrl="@Model.ReturnUrl">Resend confirmation email</a>
                </div>
            </div>
        </div>
    </div>
</div>
